{
  "name": "taiwan-island-drive",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5178",
    "build": "node scripts/verify-vehicle-surfaces.mjs --no-write && vite build && node scripts/write-precache.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5178",
    "test": "node --test \"tests/**/*.test.js\"",
    "native:build": "node scripts/build-native.mjs",
    "native:sync": "node scripts/build-native.mjs && cap sync",
    "native:assets": "capacitor-assets generate --assetPath resources --android --ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/motion": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "plist": "3.1.0",
    "vite": "8.3.2"
  },
  "overrides": {
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "sharp": "0.35.5"
  }
}
